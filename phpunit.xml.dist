<?xml version="1.0" encoding="UTF-8"?>
<!--
    Keep this file valid for every supported PHPUnit version (7.5 to 13).
    Attributes or elements added in later versions make older versions print
    a configuration warning, so use command line options for those instead.
-->
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    backupGlobals="false"
    bootstrap="vendor/autoload.php"
    colors="true"
    processIsolation="false"
    stopOnFailure="false"
    executionOrder="random"
    failOnWarning="true"
    failOnRisky="true"
    beStrictAboutOutputDuringTests="true"
>
  <testsuites>
    <testsuite name="Stasadev Test Suite">
      <directory>tests</directory>
    </testsuite>
  </testsuites>
</phpunit>
