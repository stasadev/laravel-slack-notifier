{
    "name": "stasadev/laravel-slack-notifier",
    "description": "Send exceptions and dump variables to Slack",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "notifications",
        "slack"
    ],
    "authors": [
        {
            "name": "Stanislav Zhuk",
            "email": "stanislav.zhuk.work@gmail.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/stasadev/laravel-slack-notifier",
    "require": {
        "php": "^7.1.3 || ^8.0",
        "ext-json": "*",
        "laravel/slack-notification-channel": "^1.0 || ^2.0 || ^3.0",
        "monolog/monolog": "^1.12 || ^2.0 || ^3.0",
        "symfony/polyfill-php80": "^1.20"
    },
    "require-dev": {
        "orchestra/testbench": "^3.7 || ^4.0 || ^5.0 || ^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^7.5 || ^8.5 || ^9.5 || ^10.5 || ^11.5 || ^12.0 || ^13.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Stasadev\\SlackNotifier\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stasadev\\SlackNotifier\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Stasadev\\SlackNotifier\\SlackNotifierServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-filter src --coverage-text"
    }
}
